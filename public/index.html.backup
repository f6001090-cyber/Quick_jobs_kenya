<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Quick Jobs Kenya</title>

    <style>
        :root {
            --dark: #101820;
            --dark2: #17232d;
            --green: #16a34a;
            --green-dark: #12803a;
            --light: #f5f7f6;
            --white: #ffffff;
            --text: #17202a;
            --muted: #68737d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--light);
            color: var(--text);
        }

        /* HEADER */

        header {
            background: var(--dark);
            color: var(--white);
            padding: 17px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .logo {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .logo span {
            color: var(--green);
        }

        .menu-btn {
            background: transparent;
            border: none;
            color: white;
            font-size: 25px;
            cursor: pointer;
        }

        /* HERO */

        .hero {
            background:
                linear-gradient(
                    rgba(16, 24, 32, 0.96),
                    rgba(16, 24, 32, 0.96)
                );

            color: white;
            padding: 70px 20px 65px;
            text-align: center;
        }

        .hero .badge {
            display: inline-block;
            background: rgba(22, 163, 74, 0.15);
            color: #4ade80;
            border: 1px solid rgba(74, 222, 128, 0.3);
            padding: 7px 14px;
            border-radius: 30px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 36px;
            line-height: 1.15;
            margin-bottom: 18px;
        }

        .hero h1 span {
            color: #22c55e;
        }

        .hero p {
            max-width: 620px;
            margin: auto;
            color: #cbd5dc;
            line-height: 1.7;
            font-size: 16px;
        }

        .buttons {
            margin-top: 30px;
        }

        button {
            font-family: inherit;
            cursor: pointer;
        }

        .primary-btn {
            background: var(--green);
            color: white;
            border: none;
            padding: 14px 25px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            margin: 5px;
            box-shadow: 0 5px 15px rgba(22, 163, 74, 0.25);
        }

        .primary-btn:hover {
            background: var(--green-dark);
        }

        .secondary-btn {
            background: transparent;
            color: white;
            border: 1px solid #53616c;
            padding: 13px 25px;
            border-radius: 8px;
            font-size: 15px;
            margin: 5px;
        }

        .secondary-btn:hover {
            border-color: #22c55e;
            color: #22c55e;
        }

        /* STATS */

        .stats {
            max-width: 950px;
            margin: -28px auto 0;
            padding: 0 20px;
            position: relative;
        }

        .stats-box {
            background: white;
            border-radius: 14px;
            padding: 23px 15px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }

        .stat {
            text-align: center;
        }

        .stat strong {
            display: block;
            font-size: 22px;
            color: var(--green);
            margin-bottom: 5px;
        }

        .stat span {
            color: var(--muted);
            font-size: 12px;
        }

        /* FEATURES */

        .section {
            max-width: 1050px;
            margin: auto;
            padding: 55px 20px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .section-title h2 {
            font-size: 27px;
            margin-bottom: 8px;
        }

        .section-title p {
            color: var(--muted);
        }

        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
        }

        .card {
            background: white;
            border-radius: 13px;
            padding: 25px;
            border: 1px solid #e5e9e7;
            transition: 0.2s;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.07);
        }

        .icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: #e9f8ef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-bottom: 17px;
        }

        .card h3 {
            margin-bottom: 10px;
            font-size: 18px;
        }

        .card p {
            color: var(--muted);
            line-height: 1.6;
            font-size: 14px;
        }

        /* CTA */

        .cta {
            background: var(--dark);
            color: white;
            margin: 10px 20px 45px;
            padding: 40px 20px;
            border-radius: 15px;
            text-align: center;
        }

        .cta h2 {
            margin-bottom: 10px;
        }

        .cta p {
            color: #bdc7ce;
            margin-bottom: 22px;
        }

        /* FOOTER */

        footer {
            background: #0b1116;
            color: #89949d;
            text-align: center;
            padding: 27px 20px;
            font-size: 13px;
        }

        footer strong {
            color: #22c55e;
        }

        /* MOBILE */

        @media (max-width: 600px) {

            .hero {
                padding: 55px 18px;
            }

            .hero h1 {
                font-size: 31px;
            }

            .stats-box {
                padding: 20px 8px;
            }

            .stat strong {
                font-size: 19px;
            }

            .section {
                padding: 45px 18px;
            }

            .cta {
                margin-left: 18px;
                margin-right: 18px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="logo">
        QUICK <span>JOBS</span> KENYA
    </div>

    <button class="menu-btn" onclick="alert('Menu coming soon')">
        ☰
    </button>
</header>


<section class="hero">

    <div class="badge">
        🇰🇪 Built for Kenya
    </div>

    <h1>
        Find Work.<br>
        <span>Get Paid.</span>
    </h1>

    <p>
        Quick Jobs Kenya connects skilled workers with
        clients who need tasks completed. Find opportunities,
        work, earn and grow.
    </p>

    <div class="buttons">

        <button
            class="primary-btn"
            onclick="alert('Registration coming next')">
            Create Account
        </button>

        <button
            class="secondary-btn"
            onclick="alert('Login coming next')">
            Login
        </button>

    </div>

</section>


<section class="stats">

    <div class="stats-box">

        <div class="stat">
            <strong>24/7</strong>
            <span>Opportunities</span>
        </div>

        <div class="stat">
            <strong>🇰🇪</strong>
            <span>Kenya Focused</span>
        </div>

        <div class="stat">
            <strong>M-Pesa</strong>
            <span>Easy Withdrawals</span>
        </div>

    </div>

</section>


<section class="section">

    <div class="section-title">

        <h2>How Quick Jobs Kenya Works</h2>

        <p>
            Simple steps from finding a job to getting paid.
        </p>

    </div>


    <div class="features">

        <div class="card">

            <div class="icon">🔎</div>

            <h3>Find Jobs</h3>

            <p>
                Browse available jobs posted by clients
                and discover opportunities that match
                your skills.
            </p>

        </div>


        <div class="card">

            <div class="icon">💼</div>

            <h3>Apply & Work</h3>

            <p>
                Apply for jobs you can handle, get hired
                and complete the work professionally.
            </p>

        </div>


        <div class="card">

            <div class="icon">💰</div>

            <h3>Earn</h3>

            <p>
                Your completed job earnings are recorded
                in your Quick Jobs Kenya wallet.
            </p>

        </div>


        <div class="card">

            <div class="icon">📱</div>

            <h3>Withdraw</h3>

            <p>
                Request your available earnings and
                receive your money through M-Pesa.
            </p>

        </div>

    </div>

</section>


<section class="cta">

    <h2>Ready to get started?</h2>

    <p>
        Create your account and discover your next opportunity.
    </p>

    <button
        class="primary-btn"
        onclick="alert('Registration coming next')">
        Join Quick Jobs Kenya
    </button>

</section>


<footer>

    © 2026 <strong>Quick Jobs Kenya</strong>.
    All rights reserved.

</footer>


</body>
</html>
