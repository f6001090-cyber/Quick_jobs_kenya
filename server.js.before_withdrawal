app.post("/api/jobs", authenticate, (req, res) => {

    try {

        if (req.user.role !== "client") {
            return res.status(403).json({
                success: false,
                message: "Only client accounts can post jobs."
            });
        }

        const {
            title,
            description,
            category,
            budget
        } = req.body;

        if (!title || !description || !budget) {
            return res.status(400).json({
                success: false,
                message: "Title, description and budget are required."
            });
        }

        const amount = Number(budget);

        if (!Number.isFinite(amount) || amount <= 0) {
            return res.status(400).json({
                success: false,
                message: "Enter a valid job budget."
            });
        }

        db.run(
            `
            INSERT INTO jobs
            (
                client_id,
                title,
                description,
                category,
                budget
            )
            VALUES (?, ?, ?, ?, ?)
            `,
            [
                req.user.id,
                title.trim(),
                description.trim(),
                category ? category.trim() : null,
                amount
            ]
        );

        saveDatabase();

        const result = db.exec(
            `
            SELECT
                id,
                client_id,
                title,
                description,
                category,
                budget,
                status,
                created_at
            FROM jobs
            WHERE client_id = ?
            ORDER BY id DESC
            LIMIT 1
            `,
            [req.user.id]
        );

        const row = result[0].values[0];

        res.status(201).json({
            success: true,
            message: "Job posted successfully.",
            job: {
                id: row[0],
                client_id: row[1],
                title: row[2],
                description: row[3],
                category: row[4],
                budget: row[5],
                status: row[6],
                created_at: row[7]
            }
        });

    } catch (error) {

        console.error("CREATE JOB ERROR:", error);

        res.status(500).json({
            success: false,
            message: "Could not create job."
        });
    }
});


