app.post("/api/applications", authenticate, (req, res) => {

    try {

        if (req.user.role !== "worker") {
            return res.status(403).json({
                success: false,
                message: "Only worker accounts can apply for jobs."
            });
        }

        const jobId = Number(req.body.job_id);
        const message = (req.body.message || "").trim();

        if (!Number.isInteger(jobId)) {
            return res.status(400).json({
                success: false,
                message: "Invalid job ID."
            });
        }

        const jobResult = db.exec(
            `
            SELECT id, client_id, title, budget, status
            FROM jobs
            WHERE id = ?
            `,
            [jobId]
        );

        if (
            jobResult.length === 0 ||
            jobResult[0].values.length === 0
        ) {
            return res.status(404).json({
                success: false,
                message: "Job not found."
            });
        }

        const job = jobResult[0].values[0];

        if (job[4] !== "open") {
            return res.status(400).json({
                success: false,
                message: "This job is no longer accepting applications."
            });
        }

        const existing = db.exec(
            `
            SELECT id
            FROM applications
            WHERE job_id = ?
            AND worker_id = ?
            `,
            [jobId, req.user.id]
        );

        if (
            existing.length > 0 &&
            existing[0].values.length > 0
        ) {
            return res.status(409).json({
                success: false,
                message: "You have already applied for this job."
            });
        }

        db.run(
            `
            INSERT INTO applications
            (
                job_id,
                worker_id,
                message,
                status
            )
            VALUES (?, ?, ?, 'pending')
            `,
            [
                jobId,
                req.user.id,
                message
            ]
        );

        saveDatabase();

        res.status(201).json({
            success: true,
            message: "Application submitted successfully."
        });

    } catch (error) {

        console.error("APPLICATION ERROR:", error);

        res.status(500).json({
            success: false,
            message: "Could not submit application."
        });

    }

});


