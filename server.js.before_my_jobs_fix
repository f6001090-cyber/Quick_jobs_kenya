                message: "This withdrawal has already been processed."
            });
        }

        // Return the money to the worker
        db.run(
            `
            UPDATE users
            SET wallet_balance = wallet_balance + ?
            WHERE id = ?
            `,
            [amount, userId]
        );

        db.run(
            `
            UPDATE withdrawals
            SET status = 'rejected',
                processed_at = CURRENT_TIMESTAMP
            WHERE id = ?
            `,
            [withdrawalId]
        );

        db.run(
            `
            UPDATE transactions
            SET status = 'rejected'
            WHERE user_id = ?
              AND type = 'withdrawal'
              AND amount = ?
              AND status = 'pending'
              AND description = 'Withdrawal request'
            `,
            [userId, -amount]
        );

        db.run(
            `
            INSERT INTO transactions
            (user_id, type, amount, reference, description, status)
            VALUES (?, 'refund', ?, ?, ?, 'completed')
            `,
            [
                userId,
                amount,
                "REFUND-WD-" + withdrawalId,
                "Rejected withdrawal refund"
            ]
        );

        saveDatabase();

        res.json({
            success: true,
            message: "Withdrawal rejected and money refunded."
        });

    } catch (error) {

        console.error("REJECT WITHDRAWAL ERROR:", error);

        res.status(500).json({
            success: false,
            message: "Unable to reject withdrawal."
